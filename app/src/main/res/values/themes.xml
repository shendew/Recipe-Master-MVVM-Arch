<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RecipeMaster" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:statusBarColor">@color/white</item>
    </style>

    <style name="Theme.RecipeMaster" parent="Base.Theme.RecipeMaster" />
    <style name="ScreenBackground">
        <item name="android:background">#FFFFFF</item>
    </style>
    <style name="ScreenForeground">
        <item name="android:background">@color/white</item>
        <item name="android:textColor">@color/black</item>

    </style>
        <style name="ScreenForegroundCard">
            <!-- Slightly lighter gray to create "surface" elevation -->
            <item name="cardBackgroundColor">#FFFFFF</item>
            <item name="android:textColor">#FFFFFF</item>
        </style>
    <style name="ToolBar">
        <!-- Slightly lighter gray to create "surface" elevation -->
        <item name="android:background">#B83C11</item>
        <item name="android:textColor">#FFFFFF</item>
    </style>

    <style name="TextMain">
        <item name="android:textColor">@color/black</item>
    </style>
    <style name="TextSub">
        <item name="android:textColor">#595959</item>
    </style>
    <style name="ButtonMain">
        <item name="android:backgroundTint">#B83C11</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="ProgressMain" parent="Widget.AppCompat.ProgressBar">
<!--        <item name="backgroundTint">#B83C11</item>-->
        <item name="android:indeterminateOnly">true</item>
        <item name="indicatorColor">#B83C11</item>
        <item name="android:progressDrawable">@style/Widget.MaterialComponents.CircularProgressIndicator</item>
    </style>
    <style name="FloatingMain">
        <item name="backgroundTint">#F44336</item>
    </style>
</resources>